# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PISTON_URL: Optional self-hosted Piston API URL.
# If provided, the backend will route language executions through your Piston instance.
# If not provided, it executes supported languages locally or simulates them using Gemini.
PISTON_URL=

# SMTP Configuration for Email OTP Verification (Optional)
# If provided, real emails will be dispatched via your SMTP server.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SabayCode <noreply@sabaycode.com>"

# Supabase Configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google OAuth Client ID for Gmail & Workspace Integration
VITE_GOOGLE_CLIENT_ID=147685874423-k40t5s8gbsksptc1753p0ed7q45nro2b.apps.googleusercontent.com
